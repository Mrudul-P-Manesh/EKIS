# Environment configuration for EKIS

PROJECT_NAME="Engineering Knowledge Intelligence System (EKIS)"
ENVIRONMENT=development
DEBUG=true

# LLM & Embedding Settings (Leave blank or set to 'mock' for offline deterministic test mode)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Vector DB (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=ekis_engineering_knowledge
QDRANT_EMBEDDING_DIM=384
USE_IN_MEMORY_QDRANT=true

# Knowledge Graph (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
USE_IN_MEMORY_GRAPH=true

# Metadata Database
DATABASE_URL=sqlite:///./data/ekis_metadata.db

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
